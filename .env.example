# MedPredict configuration (environment variables)
# The backend reads these from the environment when it starts; it does not load
# this file automatically. All values are optional; the defaults are shown.

# Address and port the backend listens on.
# 0.0.0.0 makes the app reachable from other devices on your network;
# use 127.0.0.1 to keep it local to this computer.
HOST=0.0.0.0
PORT=5000

# Development mode: auto-reload and the interactive debugger.
# Never enable on a machine reachable by other people.
DEBUG=false

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Allowed origins for a separately hosted frontend (comma-separated), or * for any.
CORS_ORIGINS=*
