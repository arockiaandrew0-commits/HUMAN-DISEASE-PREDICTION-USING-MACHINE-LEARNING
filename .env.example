# Disease Prediction System - Environment Configuration Template
# Copy this file to .env and update the values according to your environment

# =============================================================================
# FLASK APPLICATION SETTINGS
# =============================================================================

# Flask environment (development, testing, production, docker)
FLASK_ENV=development

# Secret key for session management and security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-here-change-in-production

# Application host and port
HOST=127.0.0.1
PORT=5000

# Debug mode (true/false)
DEBUG=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database URL for production deployments
# Examples:
# PostgreSQL: postgresql://username:password@localhost:5432/disease_prediction
# MySQL: mysql://username:password@localhost:3306/disease_prediction
# SQLite: sqlite:///path/to/database.db
DATABASE_URL=sqlite:///data/disease_prediction.db

# =============================================================================
# REDIS CONFIGURATION (for caching and session storage)
# =============================================================================

# Redis URL for caching and session management
# Examples:
# Local Redis: redis://localhost:6379/0
# Redis with auth: redis://:password@localhost:6379/0
# Redis Cloud: redis://username:password@host:port/db
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# MACHINE LEARNING CONFIGURATION
# =============================================================================

# Model training parameters
ML_RANDOM_STATE=42
ML_TEST_SIZE=0.2
ML_CV_FOLDS=5

# =============================================================================
# OPENROUTER API CONFIGURATION
# =============================================================================

# OpenRouter API key for image analysis
OPENROUTER_API_KEY=your-openrouter-api-key-here
SITE_URL=http://localhost:5000
SITE_NAME=Disease Prediction System
ML_N_ESTIMATORS=100
ML_N_JOBS=-1

# Data augmentation settings
AUGMENTATION_TARGET_SAMPLES=2000
AUGMENTATION_RANDOM_STATE=42

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API rate limiting (requests per time period)
API_RATE_LIMIT=100/hour

# Maximum symptoms per prediction request
API_MAX_SYMPTOMS=20

# Minimum confidence threshold for predictions
API_MIN_CONFIDENCE=0.1

# Enable CORS for cross-origin requests
API_ENABLE_CORS=true

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================

# Enable/disable caching
CACHE_ENABLED=true

# Cache TTL settings (in seconds)
CACHE_SYMPTOM_STATS_TTL=3600
CACHE_MODEL_TTL=86400
CACHE_MAX_SIZE=1000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file paths
LOG_FILE_PATH=logs/app.log
ERROR_LOG_FILE_PATH=logs/error.log

# Log file rotation settings
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Session timeout (in hours)
SESSION_TIMEOUT_HOURS=24

# Maximum file upload size (in MB)
MAX_CONTENT_LENGTH_MB=16

# Enable CSRF protection
ENABLE_CSRF=true

# Allowed file extensions for uploads
ALLOWED_EXTENSIONS=.csv,.json,.pkl

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================

# Enable health check endpoint
ENABLE_HEALTH_ENDPOINT=true

# Enable performance metrics collection
ENABLE_METRICS=true

# Minimum disk space required (in MB)
MIN_DISK_SPACE_MB=100

# Metrics retention period (in days)
METRICS_RETENTION_DAYS=30

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# Email service configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# Slack webhook for alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# =============================================================================
# CLOUD DEPLOYMENT SETTINGS
# =============================================================================

# AWS Configuration (if deploying to AWS)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Google Cloud Configuration (if deploying to GCP)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GCP_PROJECT_ID=your-gcp-project-id

# Azure Configuration (if deploying to Azure)
AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
AZURE_CONTAINER_NAME=your-container-name

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker-specific settings
DOCKER_HOST=0.0.0.0
DOCKER_PORT=8080

# Container resource limits
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable development tools
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILER=false

# Development database (for local development)
DEV_DATABASE_URL=sqlite:///dev_database.db

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test database
TEST_DATABASE_URL=sqlite:///:memory:

# Test data settings
TEST_SAMPLE_SIZE=100
TEST_RANDOM_STATE=42

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================

# Backup settings
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=backups/

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable specific features
FEATURE_SYMPTOM_ANALYSIS=true
FEATURE_HEALTH_PARAMETERS=true
FEATURE_EXPORT_FUNCTIONALITY=true
FEATURE_ANALYTICS_DASHBOARD=true
FEATURE_BATCH_PREDICTIONS=false

# =============================================================================
# LOCALIZATION
# =============================================================================

# Default language and timezone
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=UTC

# Supported languages (comma-separated)
SUPPORTED_LANGUAGES=en,es,fr,de

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Worker processes for production deployment
WORKERS=4
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=30

# Memory and CPU optimization
OPTIMIZE_MEMORY=true
ENABLE_MULTIPROCESSING=true

# =============================================================================
# CUSTOM SETTINGS
# =============================================================================

# Add your custom environment variables here
# CUSTOM_SETTING_1=value1
# CUSTOM_SETTING_2=value2

# =============================================================================
# NOTES
# =============================================================================

# 1. Copy this file to .env in your project root
# 2. Update all placeholder values with your actual configuration
# 3. Never commit .env files to version control
# 4. Use strong, unique passwords and keys
# 5. Regularly rotate secrets and credentials
# 6. Test your configuration in a staging environment first